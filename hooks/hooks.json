{
  "description": "把使用者在收件匣的新回覆帶進 agent 的上下文",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/inbox\" hook", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/inbox\" hook", "timeout": 10 } ] }
    ]
  }
}
