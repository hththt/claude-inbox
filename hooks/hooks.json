{
  "description": "把使用者在收件匣的新回覆帶進 agent 的上下文；開關模式下收件匣開著時把 AskUserQuestion 導去收件匣",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/inbox\" hook", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion", "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/inbox\" guard", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/inbox\" hook", "timeout": 10 } ] }
    ]
  }
}
